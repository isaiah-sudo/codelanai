// ============================================
// CodeLan Example: Space Defender
// Controls: Left/Right or A/D to steer ship
// Space to shoot lasers
// ============================================

let ship_x = 380
let ship_y = 530
let ship_w = 40
let ship_h = 30
let ship_speed = 7

let bullets = []
let enemies = []
let stars = []
let particles = []

let shoot_cooldown = 0
let spawn_timer = 0
let score = 0
let lives = 3
let game_over = false

fn reset_game() {
    ship_x = width / 2 - 20
    ship_y = height - 70
    bullets = []
    enemies = []
    particles = []
    score = 0
    lives = 3
    game_over = false
}

setup {
    window("CodeLan: Space Defender", 800, 600)
    fps(60)

    // Generate starfield background
    repeat (80) {
        push(stars, {
            x: random(0, 800),
            y: random(0, 600),
            speed: random(1, 3.5),
            size: random(1, 2.5)
        })
    }
    reset_game()
}

update {
    // Scroll starfield
    for (s in stars) {
        s.y += s.speed
        if (s.y > height) {
            s.y = 0
            s.x = random(0, width)
        }
    }

    if (not game_over) {
        // Player movement
        if (key("left") or key("a")) {
            ship_x -= ship_speed
        }
        if (key("right") or key("d")) {
            ship_x += ship_speed
        }
        ship_x = clamp(ship_x, 10, width - ship_w - 10)

        // Shooting
        shoot_cooldown -= delta
        if (key("space") and shoot_cooldown <= 0) {
            push(bullets, { x: ship_x + ship_w / 2 - 3, y: ship_y, vy: -12 })
            shoot_cooldown = 0.18
            sound("laser")
        }

        // Update bullets
        let active_bullets = []
        for (b in bullets) {
            b.y += b.vy
            if (b.y > -20) {
                push(active_bullets, b)
            }
        }
        bullets = active_bullets

        // Spawn enemies
        spawn_timer += delta
        if (spawn_timer >= 0.8) {
            spawn_timer = 0
            push(enemies, {
                x: random(40, width - 60),
                y: -30,
                vx: random(-1.5, 1.5),
                vy: random(2.5, 4.5),
                size: random(24, 38),
                hp: 1
            })
        }

        // Update enemies
        let active_enemies = []
        for (e in enemies) {
            e.y += e.vy
            e.x += e.vx

            // Bounce off sides
            if (e.x < 10 or e.x > width - e.size - 10) {
                e.vx = -e.vx
            }

            let enemy_alive = true

            // Bullet vs Enemy collision
            for (b in bullets) {
                if (collide_rect(b.x, b.y, 6, 14, e.x, e.y, e.size, e.size)) {
                    b.y = -999 // kill bullet
                    enemy_alive = false
                    score += 25

                    // Spawn explosion particles
                    repeat (12) {
                        push(particles, {
                            x: e.x + e.size / 2,
                            y: e.y + e.size / 2,
                            vx: random(-4, 4),
                            vy: random(-4, 4),
                            life: 1.0,
                            color: random_choice(["#ff3344", "#ff8800", "#ffdd00", "#ffffff"])
                        })
                    }
                    sound("explosion")
                    break
                }
            }

            // Ship vs Enemy collision
            if (enemy_alive and collide_rect(ship_x, ship_y, ship_w, ship_h, e.x, e.y, e.size, e.size)) {
                enemy_alive = false
                lives -= 1
                sound("hit")
                if (lives <= 0) {
                    game_over = true
                    sound("gameover")
                }
            }

            // Check bottom escape
            if (enemy_alive and e.y < height + 40) {
                push(active_enemies, e)
            }
        }
        enemies = active_enemies

        // Update explosion particles
        let active_particles = []
        for (p in particles) {
            p.x += p.vx
            p.y += p.vy
            p.life -= delta * 2.5
            if (p.life > 0) {
                push(active_particles, p)
            }
        }
        particles = active_particles
    } else {
        if (key("space")) {
            reset_game()
            sound("powerup")
        }
    }
}

draw {
    clear("#080912")

    // Stars
    for (s in stars) {
        rect(s.x, s.y, s.size, s.size, "#8899bb")
    }

    // Bullets (neon cyan glow)
    for (b in bullets) {
        rect(b.x, b.y, 6, 16, "#00ffff")
    }

    // Enemies (red alien saucers)
    for (e in enemies) {
        rect(e.x, e.y, e.size, e.size, "#ff2244", "#ffffff", 1)
        rect(e.x + e.size * 0.25, e.y + e.size * 0.25, e.size * 0.5, e.size * 0.5, "#ffaa00")
    }

    // Particles
    for (p in particles) {
        circle(p.x, p.y, p.life * 4, p.color)
    }

    // Player Ship (sleek jet polygon / shapes)
    if (not game_over) {
        triangle(ship_x + ship_w / 2, ship_y, ship_x, ship_y + ship_h, ship_x + ship_w, ship_y + ship_h, "#3b82f6")
        rect(ship_x + ship_w / 2 - 3, ship_y + 10, 6, 12, "#60a5fa")
        // Thruster flame
        let flame_h = random(6, 14)
        triangle(ship_x + ship_w / 2, ship_y + ship_h + flame_h, ship_x + ship_w / 2 - 5, ship_y + ship_h, ship_x + ship_w / 2 + 5, ship_y + ship_h, "#ff9900")
    }

    // HUD Header
    text("SCORE: " + score, 20, 25, 18, "#00ffff")
    text("LIVES: " + lives, width - 20, 25, 18, "#ff3366", "right")

    if (game_over) {
        rect(180, 200, 440, 200, "#121424", "#ff2244", 2)
        text_centered("MISSION FAILED", width / 2, 260, 36, "#ff2244")
        text_centered("Final Score: " + score, width / 2, 310, 20, "#ffdd00")
        text_centered("Press SPACE to Deploy Again", width / 2, 355, 16, "#ffffff")
    }
}
